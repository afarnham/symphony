# Non-secret Docker Compose settings for one Symphony deployment.
# Copy to /etc/symphony/deployment.env, keep it root-owned, and replace
# the image references with immutable multi-architecture image digests.

SYMPHONY_IMAGE=ghcr.io/ghw-consulting/symphony@sha256:REPLACE_WITH_RELEASE_DIGEST
SYMPHONY_WORKER_IMAGE=ghcr.io/ghw-consulting/symphony-agent-worker@sha256:REPLACE_WITH_RELEASE_DIGEST

SYMPHONY_WORKFLOW_FILE=/etc/symphony/WORKFLOW.md
SYMPHONY_SECRETS_DIR=/etc/symphony/secrets
SYMPHONY_BIND_ADDRESS=127.0.0.1
SYMPHONY_PORT=4000
SYMPHONY_WORKER_PROFILES=afarnham,karbas

# These IDs must match the unprivileged users baked into both images. They are
# consumed by symphony-admin and its systemd preflight, not passed as secrets.
SYMPHONY_SECRET_UID=10001
SYMPHONY_SECRET_GID=10001

# Container ceilings. Tune only after observing the deployment and rerun the
# smoke test after a change.
SYMPHONY_PIDS_LIMIT=256
SYMPHONY_MEM_LIMIT=2g
SYMPHONY_CPUS=2.0
SYMPHONY_WORKER_PIDS_LIMIT=512
SYMPHONY_WORKER_MEM_LIMIT=8g
SYMPHONY_WORKER_CPUS=4.0
SYMPHONY_TMPFS_SIZE=256m
SYMPHONY_WORKER_TMPFS_SIZE=1g

# Bounded Docker local-driver logs, per container.
SYMPHONY_LOG_MAX_SIZE=10m
SYMPHONY_LOG_MAX_FILES=5
