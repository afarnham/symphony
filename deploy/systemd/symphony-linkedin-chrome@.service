[Unit]
Description=Dedicated headless Chrome for Symphony LinkedIn lookups (%i)
Documentation=https://github.com/afarnham/symphony/blob/main/docs/linkedin-browser-bridge.md
Wants=network-online.target
After=network-online.target
Before=symphony-linkedin-bridge@%i.service symphony.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=%i
Group=%i
StateDirectory=symphony-linkedin-chrome-%i
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/google-chrome --headless=new --no-first-run --no-default-browser-check --disable-sync --password-store=basic --remote-debugging-address=127.0.0.1 --remote-debugging-port=0 --user-data-dir=/var/lib/symphony-linkedin-chrome-%i about:blank
ExecStop=-/usr/bin/node /opt/symphony/linkedin-bridge/src/stop-browser.mjs /var/lib/symphony-linkedin-chrome-%i
Restart=always
RestartSec=5s
TimeoutStopSec=30s
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
